# Deployer EOA, funded on both chains (Lasna lREACT + Sepolia ETH).
# The key lives in your secret store; env is only transport.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints: scripts (deploy/wire) read LASNA_RPC / SEPOLIA_RPC,
# foundry.toml (fork tests, forge verify) reads the *_RPC_URL set.
LASNA_RPC=https://lasna-rpc.rnk.dev/
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Reactscan (Lasna explorer) API key for forge verify.
LASNA_API_KEY=

# Live stand addresses — filled in by script/deploy-w2.sh +
# script/deploy-w21-fund.sh (or their current generation) as each
# contract lands. wire-w22.sh requires every one of these.
W2_RULES=        # RulesEngine (brain, Lasna)
W2_GASPAYER=     # GasPayer (cashier, Lasna)
W2_CONVERTER=    # FuelConverter (auto-faucet brain, Lasna)
W2_FUND=         # ReliefFund (fuel depot, Lasna)
W2_DOG=          # Watchdog (patrol, Lasna)
W2_ASSETVAULT=   # AssetVault (the safe, Sepolia)
W2_GASVAULT=     # GasVault (battery, Sepolia)
W2_EXECUTOR=     # Executor (the hands, Sepolia)
W2_BUYER=        # FuelBuyer (ETH fund -> lREACT, Sepolia)
W2_AAVE_ADAPTER= # AavePoolAdapter (Sepolia)
W2_MORPHO_ADAPTER= # MorphoPoolAdapter (Sepolia)
W2_ORACLE=       # OneToOneOracle (Sepolia)
